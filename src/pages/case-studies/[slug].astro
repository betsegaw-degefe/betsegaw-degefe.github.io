---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig, type CaseStudy } from "../../config";

export function getStaticPaths() {
  return siteConfig.caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props as { study: CaseStudy };
---

<BaseLayout
  title={`${study.name} - ${siteConfig.name}`}
  description={study.summary}
>
  <main
    class="mx-auto max-w-3xl p-8 sm:p-12 md:py-24"
    style={`--accent-color: ${siteConfig.accentColor}`}
  >
    <a
      href="/#case-studies"
      class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 transition-colors hover:text-[var(--accent-color)]"
    >
      <span aria-hidden="true">←</span> All case studies
    </a>

    <header class="mt-10">
      <p class="text-sm" style={`color: ${siteConfig.accentColor}`}>
        {study.org}
      </p>
      <h1 class="mt-2 text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
        {study.name}
      </h1>
      <div
        class="w-[75px] h-[5px] mt-4 rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      >
      </div>
      <p class="mt-6 text-lg sm:text-xl leading-relaxed text-gray-600">
        {study.summary}
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          study.skills.map((skill) => (
            <span class="px-3 py-1.5 bg-gray-900 text-white rounded-lg text-sm font-medium">
              {skill}
            </span>
          ))
        }
      </div>
    </header>

    <div class="mt-16 space-y-12 text-gray-700">
      <section>
        <h2 class="text-2xl font-bold text-gray-900">The problem</h2>
        <p class="mt-4 text-base sm:text-lg leading-relaxed">{study.problem}</p>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900">The approach</h2>
        <ul class="mt-4 space-y-3">
          {
            study.approach.map((step) => (
              <li class="flex items-start">
                <span
                  class="inline-block w-1.5 h-1.5 rounded-full mt-2.5 mr-3 flex-shrink-0"
                  style={`background-color: ${siteConfig.accentColor}`}
                />
                <span class="text-base sm:text-lg leading-relaxed">{step}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-gray-900">My role</h2>
        <p class="mt-4 text-base sm:text-lg leading-relaxed">{study.role}</p>
      </section>

      <section
        class="rounded-xl border-l-4 bg-gray-50 p-6"
        style={`border-color: ${siteConfig.accentColor}`}
      >
        <h2 class="text-2xl font-bold text-gray-900">Outcome</h2>
        <p class="mt-4 text-base sm:text-lg leading-relaxed">{study.outcome}</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
