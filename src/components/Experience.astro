---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
// Compact view: the first two bullets of each role; the full list is in the CV
const bulletsShown = 2;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:px-16 md:py-12 lg:px-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
              Experience
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 divide-y divide-gray-200">
            {siteConfig.experience.map((exp) => (
              <div class="py-5 first:pt-0 last:pb-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4">
                  <h3 class="text-base sm:text-lg font-semibold text-gray-900">
                    {exp.title}
                    <span class="font-normal" style={`color: ${siteConfig.accentColor}`}>
                      {" · "}
                      {exp.company}
                    </span>
                  </h3>
                  <span class="text-xs sm:text-sm text-gray-500 whitespace-nowrap">
                    {exp.dateRange}
                  </span>
                </div>

                <ul class="mt-2 space-y-1.5">
                  {exp.bullets.slice(0, bulletsShown).map((bullet) => (
                    <li class="flex items-start">
                      <span
                        class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0"
                        style={`background-color: ${siteConfig.accentColor}`}
                      />
                      <span class="text-sm text-gray-600 leading-relaxed">{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
